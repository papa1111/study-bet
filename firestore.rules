rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(g) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.members;
    }

    // 내 계정 정보는 나만
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{g} {
      // 코드를 아는 로그인 사용자는 그룹 조회 가능 (목록 조회는 불가)
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid]
                    && g.matches('^[a-z0-9-]{4,20}$');
      // 멤버는 수정 가능(정산, D-day), 비멤버는 "나 추가"만 가능
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'joined'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
      );
      allow delete: if false;

      match /sessions/{sid} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.uid == request.auth.uid
                      && request.resource.data.voided == false;
        allow update: if isMember(g) && (
          // 본인: 타이머/해명은 수정 가능, 신고·판정 결과는 못 건드림
          (resource.data.uid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'date', 'votes', 'reportedBy', 'voided']))
          ||
          // 다른 멤버: 신고/동의/판정만
          (resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'reportedBy', 'voided']))
        );
        allow delete: if false;
      }

      match /chat/{mid} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.uid == request.auth.uid;
        allow delete: if isMember(g);   // 100개 넘으면 오래된 것 정리
      }
    }
  }
}
