rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function groupData(g) { return get(/databases/$(database)/documents/groups/$(g)).data; }
    function isMember(g) { return signedIn() && me() in groupData(g).members; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // 맵 필드에서 내 키만 바뀌었는지
    function onlyMyKey(field) {
      return !changed().hasAny([field])
        || request.resource.data[field].diff(resource.data.get(field, {})).affectedKeys().hasOnly([me()]);
    }

    // 내 계정 정보는 나만
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /groups/{g} {
      // 코드를 아는 로그인 사용자는 그룹 조회 가능 (목록 조회는 불가)
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && g.matches('^[a-z0-9-]{4,20}$')
                    && request.resource.data.members == [me()]
                    && request.resource.data.owner == me();
      allow update: if signedIn() && (
        // 방장: 전부 가능 (규칙 변경, 강퇴, 방장 넘기기)
        resource.data.get('owner', null) == me()
        ||
        // 방장 없는 옛 그룹: 첫 멤버를 방장으로 지정만
        (resource.data.get('owner', null) == null && me() in resource.data.members
          && changed().hasOnly(['owner']) && request.resource.data.owner == resource.data.members[0])
        ||
        // 일반 멤버: 정산·D-day·내 닉네임·내 면제권만 (방장/규칙/멤버 목록은 불가)
        (me() in resource.data.members
          && !changed().hasAny(['owner', 'settings', 'members', 'joined'])
          && onlyMyKey('names') && onlyMyKey('nickChanged') && onlyMyKey('exempt'))
        ||
        // 비멤버: 나 추가만
        (!(me() in resource.data.members)
          && changed().hasOnly(['members', 'names', 'joined'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && me() in request.resource.data.members)
      );
      allow delete: if false;

      match /sessions/{sid} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.uid == me()
                      && request.resource.data.voided == false
                      && request.resource.data.seconds == 0
                      && request.resource.data.start <= request.time.toMillis() + 60000;
        allow update: if isMember(g) && (
          // 본인: 종료·해명·수정 반영. 신고/판정은 못 건드리고, 공부 초는 실제 경과 시간과 18시간을 못 넘음
          (resource.data.uid == me()
            && !changed().hasAny(['uid', 'date', 'start', 'votes', 'reportedBy', 'voided'])
            && request.resource.data.seconds <= (request.time.toMillis() - resource.data.start) / 1000 + 120
            && request.resource.data.seconds <= 64800)
          ||
          // 다른 멤버: 구라 신고/동의/판정만
          (resource.data.uid != me() && changed().hasOnly(['votes', 'reportedBy', 'voided']))
        );
        allow delete: if false;
      }

      match /edits/{eid} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.uid == me()
                      && request.resource.data.votes.size() == 0
                      && (request.resource.data.status == 'open'
                          || (request.resource.data.status == 'approved' && groupData(g).members.size() == 1));
        allow update: if isMember(g) && (
          (resource.data.uid != me() && changed().hasOnly(['votes', 'status'])
            && request.resource.data.status in ['open', 'approved'])
          ||
          (resource.data.uid == me() && changed().hasOnly(['status'])
            && resource.data.status == 'approved' && request.resource.data.status == 'applied')
        );
        allow delete: if false;
      }

      match /pokes/{pid} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.from == me();
        allow delete: if isMember(g) && resource.data.to == me();
      }

      // 알림 토큰: 본인만 쓰기, 읽기는 알림 서버(관리자 권한)만
      match /tokens/{uid} {
        allow read: if false;
        allow write: if isMember(g) && me() == uid;
      }

      match /chat/{mid} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.uid == me();
        allow delete: if isMember(g);   // 100개 넘으면 오래된 것 정리
      }
    }
  }
}
